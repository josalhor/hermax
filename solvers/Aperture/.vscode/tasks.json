{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "make -j$(nproc) dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "make -j$(nproc) release",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "make -j$(nproc) debug",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Test",
      "type": "shell",
      "command": "make -j$(nproc) build-tests",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "make run-tests",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run",
      "type": "shell",
      "options": {
        "env": {
          "EXEC": "build/aperture",
          "WCNF": "instances/instance1.wcnf"
        }
      },
      "command": "./${EXEC} ${WCNF}",
      "group": "test",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build & Run",
      "dependsOrder": "sequence",
      "dependsOn": ["Build", "Run"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make clean-all",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Rebuild",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Build"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Clean, Build & Run",
      "dependsOrder": "sequence",
      "dependsOn": ["Clean", "Build", "Run"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
